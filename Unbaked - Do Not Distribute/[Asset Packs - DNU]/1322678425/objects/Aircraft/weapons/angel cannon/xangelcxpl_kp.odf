// =====================
// DAY WRECKER EXPLOSION
// =====================

[ExplosionClass]
classLabel = "explosion"
FriendlyFireDamage = true

particleTypes = 4

particleClass1 = "xangelcxpl_kp.shock"
particleCount1 = 1
particleVeloc1 = "0.0 0.0 0.0"

particleClass2 = "xangelcxpl_kp.light"
particleCount2 = 1
particleVeloc2 = "0.0 0.0 0.0"

particleClass3 = "xangelcxpl_kp.flame"
particleCount3 = 15 //30
particleVeloc3 = "30.0 10.0 30.0"
particlePosVar3 = "5.0 0.0 5.0"

particleClass4 = "xangelcxpl_kp.smoke"
particleCount4 = 20 //30
particleVeloc4 = "15.0 5.0 15.0"
particlePosVar4 = "5.0 0.0 5.0"

explSound = "xemt1.wav"

damageRadius = 8.0

damageValue(N) = 800
damageValue(L) = 700
damageValue(H) = 600

damageValue(S) = 700
damageValue(D) = 800
damageValue(A) = 600

kickRadius = 8.0
kickOmega = 0.0
kickVeloc = 2.0

[Shock]
simulateBase = "sim_null"
lifeTime = 1.0
renderBase = "draw_sphere"
textureName = "vsmoke.tga"
textureBlend = "one one modulate"
startColor = "255 255 63 255"
finishColor = "255 0 0 0"
startRadius = 0.0
finishRadius = 8.0
animateTime = 1.0
latitudeBands = 32
longitudeSegments = 64

[Light]
simulateBase = "sim_null"
lifeTime = 1.5
renderBase = "draw_light"
startColor = "255 255 63 2550"
finishColor = "255 0 0 0"
startRadius = 8.0
finishRadius = 8.0
animateTime = 1.5
attenuateConstant = 1.0
attenuateLinear = 0.0
attenuateQuadratic = 15.0
lensFlare = 0

[Flame]
simulateBase = "sim_smoke"
lifeTime = 3.0
renderBase = "draw_twirl"
textureName = "flame2.tga"
textureBlend = "one one modulate"
startColor = "255 255 63 255"
finishColor = "255 0 0 0"
startRadius = 8.0
finishRadius = 3.0
animateTime = 3.0

[Smoke]
simulateBase = "sim_smoke"
lifeTime = 5.0
renderBase = "draw_twirl"
textureName = "smoke.tga"
textureBlend = "srcalpha invsrcalpha modulatealpha"
startColor = "31 31 31 63"
finishColor = "63 63 63 0"
startRadius = 8.0
finishRadius = 3.0
animateTime = 5.0

