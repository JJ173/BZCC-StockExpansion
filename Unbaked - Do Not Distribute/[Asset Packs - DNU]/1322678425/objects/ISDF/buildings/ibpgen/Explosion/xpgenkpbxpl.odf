particleVeloc4 = "40.0 10.0 40.0"
particlePosVar4 = "5.0 0.0 5.0"

particleClass5 = "xpgenkpbxpl.ring"
particleCount5 = 1
particleVeloc5 = "0.0 0.0 0.0"

particleClass6 = "xpgenkpbxpl.sparks"
particleCount6 = 60 //30
particleVeloc6 = "100.0 100.0 100.0"
particlePosVar6 = "5.0 5.0 5.0"


explSound = "xbuild.wav"
damageRadius = 50.0
damageValue(N) = 2000
damageValue(L) = 2000
damageValue(H) = 2000
damageValue(S) = 2000
damageValue(D) = 2000
damageValue(A) = 2000
kickRadius = 60.0
kickOmega = 0.0
