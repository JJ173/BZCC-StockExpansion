[OrdnanceClass]
classLabel = "bullet"

shotGeometry = "iostba00.fbx"  //"gatstab.xsi"
shotSound = "ordin_a.wav"

renderName = "atstab_c_kp.render"

xplGround = "xstabgnd_c"
xplVehicle = "xstabcar_c"
xplBuilding = "xmslbld"

ammoCost = 11
lifeSpan = 1.0 // 100m
shotSpeed = 100.0

damageValue(N) = 130 // none // 260
damageValue(L) = 120 // light // 240
damageValue(H) = 100 // heavy // 200

damageValue(S) = 120 // standard // 240
damageValue(D) = 100 // deflection // 200
damageValue(A) = 130 // absorbtion // 130

[Render]
renderBase = "draw_multi"
renderCount = 2
renderName1 = "atstab_c_kp.smoke"
renderName2 = "atstab_c_kp.flame"

[Smoke]
renderBase = "draw_twirl_trail"
textureName = "smoke.tga"
textureBlend = "srcalpha invsrcalpha modulatealpha"
startColor = "255 255 255 255" //"180 180 180 128"
finishColor = "153 153 153 0" //"128 128 128 0"
startRadius = 0.4 //0.5
finishRadius = 0.08 //0.1
animateTime = 0.16
emitDelay = 0.005 //0.005 //0.004
emitVelocity = "0 0 0" //0.0 0.0 0.0
emitVariance = "0.0 0.0 0.0"
emitLife = 0.16

[Flame]
renderBase = "draw_twirl" //sprite"
textureName = "plasma.tga"
textureBlend = "one one modulate"
startColor = "255 127 63 255" //"100 20 0 155"
finishColor = "255 127 63 255" //"100 20 0 155"
startRadius = 0.4 //0.5
finishRadius = 0.4 //0.5
rotationRate = 5.0
